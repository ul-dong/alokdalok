[
 {
  "file": "v0001.mp3",
  "text": "같이 세어 볼까요?"
 },
 {
  "file": "v0002.mp3",
  "text": "정말 잘했어요!"
 },
 {
  "file": "v0003.mp3",
  "text": "코인을 받았어요."
 },
 {
  "file": "v0004.mp3",
  "text": "스티커가 가득 찼어요."
 },
 {
  "file": "v0005.mp3",
  "text": "지우개로 떼어 볼까요?"
 },
 {
  "file": "v0006.mp3",
  "text": "앞 단계를 먼저 놀아 볼까요?"
 },
 {
  "file": "v0007.mp3",
  "text": "안녕! 오늘은 뭐 하고 놀까?"
 },
 {
  "file": "v0008.mp3",
  "text": "안녕!"
 },
 {
  "file": "v0009.mp3",
  "text": "반가워!"
 },
 {
  "file": "v0010.mp3",
  "text": "숫자 놀이를 해 볼까요?"
 },
 {
  "file": "v0011.mp3",
  "text": "색깔 놀이를 해 볼까요?"
 },
 {
  "file": "v0012.mp3",
  "text": "안녕! 함께 놀 친구를 골라 볼까요?"
 },
 {
  "file": "v0013.mp3",
  "text": "내 이름을 지어 줄래?"
 },
 {
  "file": "v0014.mp3",
  "text": "목소리 안내를 켰어요."
 },
 {
  "file": "v0015.mp3",
  "text": "안녕! 나랑 같이 놀자!"
 },
 {
  "file": "v0016.mp3",
  "text": "몇 개 있을까요?"
 },
 {
  "file": "v0017.mp3",
  "text": "몇 마리 있을까요?"
 },
 {
  "file": "v0018.mp3",
  "text": "찾아볼까요?"
 },
 {
  "file": "v0019.mp3",
  "text": "정말 멋져요!"
 },
 {
  "file": "v0020.mp3",
  "text": "출발!"
 },
 {
  "file": "v0021.mp3",
  "text": "코인 10개가 필요해요."
 },
 {
  "file": "v0022.mp3",
  "text": "놀이하면서 모아 볼까요?"
 },
 {
  "file": "v0422.mp3",
  "text": "화면이 너무 가까워요."
 },
 {
  "file": "v0423.mp3",
  "text": "조금 뒤로 가 볼까요?"
 },
 {
  "file": "v0424.mp3",
  "text": "바르게 앉아서 봐요."
 },
 {
  "file": "v0425.mp3",
  "text": "화면을 똑바로 봐 주세요."
 },
 {
  "file": "v0426.mp3",
  "text": "잘했어요! 다시 놀아요."
 },
 {
  "file": "v0466.mp3",
  "text": "오늘은 여기까지!"
 },
 {
  "file": "v0467.mp3",
  "text": "내일 또 만나요."
 },
 {
  "file": "v0468.mp3",
  "text": "창밖 먼 곳을 봐요."
 },
 {
  "file": "v0469.mp3",
  "text": "잘 쉬었어요! 다시 놀아요."
 },
 {
  "file": "v0470.mp3",
  "text": "부모님을 불러 주세요."
 },
 {
  "file": "v0471.mp3",
  "text": "15분 더 놀 수 있어요."
 },
 {
  "file": "v0472.mp3",
  "text": "모양 놀이를 해 볼까요?"
 },
 {
  "file": "v0473.mp3",
  "text": "크기 놀이를 해 볼까요?"
 },
 {
  "file": "v0474.mp3",
  "text": "짝 맞추기를 해 볼까요?"
 },
 {
  "file": "v0475.mp3",
  "text": "다시 찾아볼까요?"
 },
 {
  "file": "v0476.mp3",
  "text": "똑같은 모양을 찾아볼까요?"
 },
 {
  "file": "v0477.mp3",
  "text": "똑같은 그림 두 장을 찾아볼까요?"
 },
 {
  "file": "v0478.mp3",
  "text": "똑같은"
 },
 {
  "file": "v0479.mp3",
  "text": "똑같아요!"
 },
 {
  "file": "v0480.mp3",
  "text": "가장"
 },
 {
  "file": "v0481.mp3",
  "text": "놀이터 가기"
 },
 {
  "file": "v0482.mp3",
  "text": "내 캐릭터"
 },
 {
  "file": "v0483.mp3",
  "text": "꾸미기 상점"
 },
 {
  "file": "v0484.mp3",
  "text": "집으로"
 },
 {
  "file": "v0485.mp3",
  "text": "뒤로"
 },
 {
  "file": "v0486.mp3",
  "text": "다시 듣기"
 },
 {
  "file": "v0487.mp3",
  "text": "놀이터에 왔어요!"
 },
 {
  "file": "v0488.mp3",
  "text": "어디에서 놀까요?"
 },
 {
  "file": "v0489.mp3",
  "text": "꾹 누르고 있어요."
 },
